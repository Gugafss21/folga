<UserControl x:Class="Folga.App.Views.SegundoPlanoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Folga.App.ViewModels"
             xmlns:v="clr-namespace:Folga.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SegundoPlanoViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="160" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="160" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Segundo plano" Style="{StaticResource Text.Headline}" />
            <TextBlock Style="{StaticResource Text.Body}" Margin="0,6,0,0"
                       Text="O que acontece com navegador, Discord e launchers enquanto você joga. Nada fecha: eles só cedem CPU, memória e rede ao jogo, e tudo volta ao normal quando o jogo fecha." />
        </StackPanel>

        <!-- Estado real, lido do Windows -->
        <Grid Grid.Row="1">
            <DataGrid x:Name="GroupsGrid" Style="{StaticResource Table}" ItemsSource="{Binding Groups}" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn EditingElementStyle="{StaticResource GridText}" Header="App" Binding="{Binding Name}" Width="2*"
                                        v:Hint.Text="Estado real de cada app, lido do Windows a cada 2 s (não é o que o Folga acha que aplicou). Os valores mudam quando um jogo abre." />
                    <DataGridTextColumn EditingElementStyle="{StaticResource GridText}" Header="Processos" Binding="{Binding Processes}" Width="*"
                                        v:Hint.Text="Quantos processos o app tem abertos agora. Navegadores abrem um por aba e por extensão." />
                    <DataGridTemplateColumn Header="RAM" Width="1.6*"
                                            v:Hint.Text="RAM privada somando todos os processos do app / orçamento da regra. Em âmbar: acima do orçamento; durante o jogo, os maiores processos são esvaziados.">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock x:Name="Ram" Text="{Binding Memory}" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding OverBudget}" Value="True">
                                        <Setter TargetName="Ram" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn EditingElementStyle="{StaticResource GridText}" Header="Prioridade" Binding="{Binding Priority}" Width="1.4*"
                                        v:Hint.Text="Prioridade de CPU atual do app. Com um jogo aberto deve aparecer a da regra (ex.: Abaixo do normal)." />
                    <DataGridTextColumn EditingElementStyle="{StaticResource GridText}" Header="EcoQoS" Binding="{Binding EcoQos}" Width="*"
                                        v:Hint.Text="Modo de eficiência do Windows. Ligado: o app roda em clock mais baixo e não disputa CPU com o jogo. Automático: o Windows decide." />
                    <DataGridTextColumn EditingElementStyle="{StaticResource GridText}" Header="Núcleos" Binding="{Binding Cores}" Width="*"
                                        v:Hint.Text="Onde o app pode rodar. Todos = sem restrição; com um jogo aberto deve aparecer o número de threads reservadas ao fundo." />
                    <DataGridTextColumn EditingElementStyle="{StaticResource GridText}" Header="Memória" Binding="{Binding MemoryPriority}" Width="*"
                                        v:Hint.Text="Prioridade de memória. Baixa: quando falta RAM, o Windows tira primeiro as páginas deste app, não as do jogo." />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Style="{StaticResource Text.Empty}"
                       Visibility="{Binding HasItems, ElementName=GroupsGrid, Converter={x:Static vm:NoItemsToVisibilityConverter.Instance}}"
                       Text="Nenhum app das regras está aberto agora. Navegador, Discord e launchers aparecem aqui quando estão abertos, com o estado real lido do Windows." />
        </Grid>

        <!-- Standby list -->
        <Border Grid.Row="2" Style="{StaticResource Panel}" Padding="14,10" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal">
                <CheckBox IsChecked="{Binding PurgeStandbyList}" Content="Limpar a standby list durante o jogo quando a RAM livre cair abaixo de" VerticalAlignment="Center"
                          ToolTip="A standby list é o cache de arquivos do Windows na RAM. Com o jogo aberto e a RAM livre abaixo do limite, o Folga esvazia esse cache (no máximo 1 vez por minuto) para o jogo não esperar o Windows liberar memória. Não fecha nada." />
                <TextBox Text="{Binding FreeThresholdMb}" Width="80" Margin="10,0,6,0" VerticalAlignment="Center"
                         ToolTip="Limite de RAM livre, em MB, para disparar a limpeza. Padrão 1024. Valores maiores limpam mais vezes. Mínimo 256." />
                <TextBlock Text="MB" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="3" Text="Regras" Style="{StaticResource Text.Section}" Margin="0,20,0,10"
                   ToolTip="O que fazer com cada app de fundo enquanto um jogo está aberto. Ao fechar o jogo, tudo volta ao que era." />

        <DockPanel Grid.Row="4">
            <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <Button DockPanel.Dock="Left" Content="Nova regra" Style="{StaticResource Button.Plain}" Command="{Binding AddCommand}"
                        ToolTip="Adiciona uma regra em branco para outro app de fundo (ex.: Spotify.exe)." />
                <Button DockPanel.Dock="Left" Content="Remover" Style="{StaticResource Button.Plain}" Command="{Binding RemoveCommand}" Margin="8,0,0,0"
                        ToolTip="Tira a regra selecionada. Só vale depois de Salvar." />
                <Button DockPanel.Dock="Right" Content="Salvar" Style="{StaticResource Button.Primary}" Command="{Binding SaveCommand}"
                        ToolTip="Grava as regras e o limite da standby list e aplica na hora. Se um jogo estiver aberto, o Folga desfaz e reaplica com as regras novas." />
                <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="16,0" />
            </DockPanel>
            <Grid>
                <DataGrid x:Name="RulesGrid" Style="{StaticResource Table}" ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}"
                          FrozenColumnCount="2" HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn ElementStyle="{StaticResource GridCheck}" EditingElementStyle="{StaticResource GridCheckEdit}" Header="Ativa" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="58"
                                                v:Hint.Text="Desmarcada: a regra fica guardada, mas o Folga não mexe nesse app." />
                        <DataGridTextColumn EditingElementStyle="{StaticResource GridText}" Header="Nome" Binding="{Binding Name}" Width="130"
                                            v:Hint.Text="Nome que aparece na tabela de cima. Só para você identificar." />
                        <DataGridTextColumn EditingElementStyle="{StaticResource GridText}" Header="Executáveis" Binding="{Binding ExecutablesText}" Width="180"
                                            v:Hint.Text="Nome do .exe do app; vários separados por vírgula. Aceita * (ex.: Epic*.exe). Todos os processos com esse nome entram na regra." />
                        <DataGridComboBoxColumn Header="Prioridade" Width="136"
                                                ItemsSource="{x:Static vm:Choices.BackgroundPriorities}"
                                                SelectedValuePath="Value" DisplayMemberPath="Label"
                                                SelectedValueBinding="{Binding Priority}"
                                                EditingElementStyle="{StaticResource ChoiceCombo}"
                                                v:Hint.Text="Prioridade de CPU do app durante o jogo. Abaixo do normal faz o app ceder a CPU sem travar. Passe o mouse em cada opção para ver o que faz." />
                        <DataGridComboBoxColumn Header="Núcleos" Width="112"
                                                ItemsSource="{x:Static vm:Choices.BackgroundCoreModes}"
                                                SelectedValuePath="Value" DisplayMemberPath="Label"
                                                SelectedValueBinding="{Binding Cores}"
                                                EditingElementStyle="{StaticResource ChoiceCombo}"
                                                v:Hint.Text="Para quais núcleos o app é mandado durante o jogo (CPU Sets do Windows). No seu Ryzen, Automático = núcleo 6, o último do mapa de núcleos." />
                        <DataGridCheckBoxColumn ElementStyle="{StaticResource GridCheck}" EditingElementStyle="{StaticResource GridCheckEdit}" Header="EcoQoS" Binding="{Binding EcoQos, UpdateSourceTrigger=PropertyChanged}" Width="74"
                                                v:Hint.Text="Liga o modo de eficiência do Windows no app: clock mais baixo, menos disputa com o jogo. Deixe desmarcado em apps de voz (Discord) se a voz picotar." />
                        <DataGridCheckBoxColumn ElementStyle="{StaticResource GridCheck}" EditingElementStyle="{StaticResource GridCheckEdit}" Header="I/O ↓" Binding="{Binding LowIoPriority, UpdateSourceTrigger=PropertyChanged}" Width="62"
                                                v:Hint.Text="Prioridade de disco baixa: o app lê e grava no SSD/HD depois do jogo. Ajuda quando o jogo carrega mapa enquanto algo baixa ou sincroniza." />
                        <DataGridCheckBoxColumn ElementStyle="{StaticResource GridCheck}" EditingElementStyle="{StaticResource GridCheckEdit}" Header="Mem. ↓" Binding="{Binding LowMemoryPriority, UpdateSourceTrigger=PropertyChanged}" Width="70"
                                                v:Hint.Text="Prioridade de memória baixa: quando a RAM aperta, o Windows tira primeiro as páginas deste app, não as do jogo." />
                        <DataGridTextColumn EditingElementStyle="{StaticResource GridText}" Header="RAM MB" Binding="{Binding MemoryBudgetMb}" Width="82"
                                            v:Hint.Text="Orçamento de RAM do app inteiro, em MB (todas as abas somadas). Acima dele, a cada 5 s os maiores processos são esvaziados: a memória vai para o disco e o app continua aberto, só mais lento ao voltar. 0 = sem orçamento." />
                        <DataGridTextColumn EditingElementStyle="{StaticResource GridText}" Header="Teto MB" Binding="{Binding HardWorkingSetCapMb}" Width="82"
                                            v:Hint.Text="Teto rígido por processo, em MB. Nenhum processo do app passa disso na RAM; o excesso vai para o disco. Mais agressivo que o orçamento e pode deixar o app lento. 0 = desligado (recomendado)." />
                        <DataGridTextColumn EditingElementStyle="{StaticResource GridText}" Header="Upload kbps" Binding="{Binding UploadLimitKbps}" Width="104"
                                            v:Hint.Text="Limite de upload do app durante o jogo, em kbit/s (4000 = 4 Mbit/s), por política de QoS do Windows. Segura backups, sincronização e envios que enchem o roteador e sobem o ping. Só vale para .exe sem *. 0 = sem limite." />
                        <DataGridCheckBoxColumn ElementStyle="{StaticResource GridCheck}" EditingElementStyle="{StaticResource GridCheckEdit}" Header="Congelar" Binding="{Binding SuspendDuringGame, UpdateSourceTrigger=PropertyChanged}" Width="86"
                                                v:Hint.Text="Congela o app inteiro enquanto o jogo estiver aberto: zero CPU, disco e rede. Ele volta exatamente de onde parou quando o jogo fecha. Agressivo: o app não responde nesse tempo. Evite no OneDrive se o jogo salvar em pasta sincronizada." />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Style="{StaticResource Text.Empty}"
                           Visibility="{Binding HasItems, ElementName=RulesGrid, Converter={x:Static vm:NoItemsToVisibilityConverter.Instance}}"
                           Text="Nenhuma regra. Sem regras, o Folga só dá prioridade ao jogo e não segura nenhum app. Clique em Nova regra para adicionar um (ex.: chrome.exe, Discord.exe)." />
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
