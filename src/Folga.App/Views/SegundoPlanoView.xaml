<UserControl x:Class="Folga.App.Views.SegundoPlanoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Folga.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SegundoPlanoViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="160" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="160" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Segundo plano" Style="{StaticResource Text.Headline}" />
            <TextBlock Style="{StaticResource Text.Body}" Margin="0,6,0,0"
                       Text="Só valem enquanto um jogo está aberto. O orçamento de RAM soma todos os processos do app; acima dele os maiores são esvaziados (vão para o disco, não fecham)." />
        </StackPanel>

        <!-- Estado real, lido do Windows -->
        <DataGrid Grid.Row="1" Style="{StaticResource Table}" ItemsSource="{Binding Groups}" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="App" Binding="{Binding Name}" Width="2*" />
                <DataGridTextColumn Header="Processos" Binding="{Binding Processes}" Width="*" />
                <DataGridTemplateColumn Header="RAM" Width="1.6*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="Ram" Text="{Binding Memory}" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding OverBudget}" Value="True">
                                    <Setter TargetName="Ram" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Prioridade" Binding="{Binding Priority}" Width="1.4*" />
                <DataGridTextColumn Header="EcoQoS" Binding="{Binding EcoQos}" Width="*" />
                <DataGridTextColumn Header="Núcleos" Binding="{Binding Cores}" Width="*" />
                <DataGridTextColumn Header="Memória" Binding="{Binding MemoryPriority}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Standby list -->
        <Border Grid.Row="2" Style="{StaticResource Panel}" Padding="14,10" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal">
                <CheckBox IsChecked="{Binding PurgeStandbyList}" Content="Limpar a standby list durante o jogo quando a RAM livre cair abaixo de" VerticalAlignment="Center" />
                <TextBox Text="{Binding FreeThresholdMb}" Width="80" Margin="10,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="MB" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="3" Text="Regras" Style="{StaticResource Text.Section}" Margin="0,20,0,10" />

        <DockPanel Grid.Row="4">
            <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <Button DockPanel.Dock="Left" Content="Nova regra" Style="{StaticResource Button.Plain}" Command="{Binding AddCommand}" />
                <Button DockPanel.Dock="Left" Content="Remover" Style="{StaticResource Button.Plain}" Command="{Binding RemoveCommand}" Margin="8,0,0,0" />
                <Button DockPanel.Dock="Right" Content="Salvar" Style="{StaticResource Button.Plain}" Command="{Binding SaveCommand}" />
                <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="16,0" />
            </DockPanel>
            <DataGrid Style="{StaticResource Table}" ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Ativa" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="50" />
                    <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="1.3*" />
                    <DataGridTextColumn Header="Executáveis" Binding="{Binding ExecutablesText}" Width="1.6*" />
                    <DataGridComboBoxColumn Header="Prioridade" Width="136"
                                            ItemsSource="{x:Static vm:Choices.BackgroundPriorities}"
                                            SelectedValuePath="Value" DisplayMemberPath="Label"
                                            SelectedValueBinding="{Binding Priority}" />
                    <DataGridComboBoxColumn Header="Núcleos" Width="112"
                                            ItemsSource="{x:Static vm:Choices.BackgroundCoreModes}"
                                            SelectedValuePath="Value" DisplayMemberPath="Label"
                                            SelectedValueBinding="{Binding Cores}" />
                    <DataGridCheckBoxColumn Header="EcoQoS" Binding="{Binding EcoQos, UpdateSourceTrigger=PropertyChanged}" Width="62" />
                    <DataGridCheckBoxColumn Header="I/O ↓" Binding="{Binding LowIoPriority, UpdateSourceTrigger=PropertyChanged}" Width="56" />
                    <DataGridCheckBoxColumn Header="Mem. ↓" Binding="{Binding LowMemoryPriority, UpdateSourceTrigger=PropertyChanged}" Width="62" />
                    <DataGridTextColumn Header="RAM MB" Binding="{Binding MemoryBudgetMb}" Width="70" />
                    <DataGridTextColumn Header="Teto MB" Binding="{Binding HardWorkingSetCapMb}" Width="70" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</UserControl>
