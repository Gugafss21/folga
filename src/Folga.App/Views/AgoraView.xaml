<UserControl x:Class="Folga.App.Views.AgoraView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Folga.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:AgoraViewModel}">
    <UserControl.Resources>
        <Style x:Key="MetricCell" TargetType="StackPanel">
            <Setter Property="Margin" Value="20,14,20,14" />
        </Style>
        <Style x:Key="MetricDivider" TargetType="Rectangle">
            <Setter Property="Width" Value="1" />
            <Setter Property="Fill" Value="{StaticResource LineBrush}" />
            <Setter Property="Margin" Value="0,12" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <!-- Jogo + botão principal -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding GameTitle}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Headline}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSessionActive}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding GameNote}" Style="{StaticResource Text.Body}" Margin="0,6,24,0" />
                </StackPanel>
                <ToggleButton Grid.Column="1" Style="{StaticResource BoostToggle}" VerticalAlignment="Top"
                              IsChecked="{Binding BoostEnabled}">
                    <ToggleButton.Content>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Boost desligado" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BoostEnabled}" Value="True">
                                            <Setter Property="Text" Value="Boost ligado" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </ToggleButton.Content>
                </ToggleButton>
            </Grid>

            <!-- Números -->
            <Border Style="{StaticResource Panel}" Margin="0,24,0,0">
                <WrapPanel>
                    <StackPanel Style="{StaticResource MetricCell}">
                        <TextBlock Text="CPU" Style="{StaticResource Text.Label}" />
                        <TextBlock Text="{Binding CpuText}" Style="{StaticResource Text.Number}" />
                    </StackPanel>
                    <Rectangle Style="{StaticResource MetricDivider}" />
                    <StackPanel Style="{StaticResource MetricCell}">
                        <TextBlock Text="RAM em uso (GB)" Style="{StaticResource Text.Label}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding RamUsedText}" Style="{StaticResource Text.Number}" />
                            <TextBlock Text="{Binding RamTotalText}" Style="{StaticResource Text.Label}" VerticalAlignment="Bottom" Margin="6,0,0,6" />
                        </StackPanel>
                    </StackPanel>
                    <Rectangle Style="{StaticResource MetricDivider}" />
                    <StackPanel Style="{StaticResource MetricCell}" ToolTip="Listas free + zero: RAM realmente vaga">
                        <TextBlock Text="RAM livre (GB)" Style="{StaticResource Text.Label}" />
                        <TextBlock Text="{Binding FreeText}" Style="{StaticResource Text.Number}" />
                    </StackPanel>
                    <Rectangle Style="{StaticResource MetricDivider}" />
                    <StackPanel Style="{StaticResource MetricCell}" ToolTip="Cache que o Windows pode reaproveitar">
                        <TextBlock Text="Standby (GB)" Style="{StaticResource Text.Label}" />
                        <TextBlock Text="{Binding StandbyText}" Style="{StaticResource Text.Number}" />
                    </StackPanel>
                    <Rectangle Style="{StaticResource MetricDivider}" />
                    <StackPanel Style="{StaticResource MetricCell}" ToolTip="Processos de fundo com prioridade, núcleos e memória reduzidos">
                        <TextBlock Text="Apps segurados" Style="{StaticResource Text.Label}" />
                        <TextBlock Text="{Binding HeldText}" Style="{StaticResource Text.Number}" />
                    </StackPanel>
                    <Rectangle Style="{StaticResource MetricDivider}" />
                    <StackPanel Style="{StaticResource MetricCell}" ToolTip="Processos esvaziados pelo orçamento de RAM · limpezas da standby list">
                        <TextBlock Text="Esvaziados · limpezas" Style="{StaticResource Text.Label}" />
                        <TextBlock Text="{Binding CleanupText}" Style="{StaticResource Text.Number}" />
                    </StackPanel>
                </WrapPanel>
            </Border>

            <!-- Mapa de núcleos -->
            <DockPanel Margin="0,28,0,10">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="10" Height="10" CornerRadius="2" Background="{StaticResource AccentBrush}" />
                    <TextBlock Text="jogo" Style="{StaticResource Text.Label}" Margin="6,0,16,0" />
                    <Border Width="10" Height="10" CornerRadius="2" Background="{StaticResource TextTertiaryBrush}" />
                    <TextBlock Text="fundo" Style="{StaticResource Text.Label}" Margin="6,0,0,0" />
                </StackPanel>
                <TextBlock Text="Núcleos" Style="{StaticResource Text.Section}" />
            </DockPanel>
            <TextBlock Text="{Binding CoreLegend}" Style="{StaticResource Text.Body}" Margin="0,0,0,12" />

            <ItemsControl ItemsSource="{Binding Cores}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding DataContext.CoreColumns, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:CoreTileViewModel}">
                        <Border x:Name="Tile" Style="{StaticResource Panel}" Margin="0,0,8,8" Padding="12,10">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock x:Name="RoleText" DockPanel.Dock="Right" Text="{Binding Role}" Style="{StaticResource Text.Label}" />
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Label}" Foreground="{StaticResource TextSecondaryBrush}" />
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding Threads}" Margin="0,10,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ThreadBarViewModel}">
                                            <StackPanel Margin="0,0,6,0">
                                                <!-- Barra vertical de uso; altura = uso %. -->
                                                <Grid Height="56">
                                                    <Border Background="{StaticResource BackgroundBrush}" CornerRadius="3" />
                                                    <Border x:Name="Bar" VerticalAlignment="Bottom" CornerRadius="3"
                                                            Background="{Binding DataContext.IsBackground, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=1}, Converter={x:Static vm:CoreBrushConverter.Instance}}">
                                                        <Border.Height>
                                                            <MultiBinding Converter="{x:Static vm:PercentToHeightConverter.Instance}">
                                                                <Binding Path="Usage" />
                                                                <Binding Source="56" />
                                                            </MultiBinding>
                                                        </Border.Height>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="{Binding Text}" Style="{StaticResource Text.Label}" HorizontalAlignment="Center" Margin="0,4,0,0"
                                                           Typography.NumeralAlignment="Tabular" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsGameActive}" Value="True">
                                <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="RoleText" Property="Foreground" Value="{StaticResource AccentBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Avisos -->
            <Border Style="{StaticResource Panel}" Margin="0,16,0,0" Padding="14,10"
                    Visibility="{Binding RamWarning, Converter={x:Static vm:NotNullToVisibilityConverter.Instance}}">
                <TextBlock Text="{Binding RamWarning}" Style="{StaticResource Text.Body}" Foreground="{StaticResource AccentBrush}" />
            </Border>

            <!-- Atividade -->
            <DockPanel Margin="0,28,0,10">
                <TextBlock DockPanel.Dock="Right" Text="{Binding RamSpeed}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                <TextBlock Text="Atividade" Style="{StaticResource Text.Section}" />
            </DockPanel>
            <Border Style="{StaticResource Panel}" Padding="14,10">
                <ItemsControl ItemsSource="{Binding Activity}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Style="{StaticResource Text.Mono}" Margin="0,2" ToolTip="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
