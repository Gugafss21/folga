<UserControl x:Class="Folga.App.Views.AgoraView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Folga.App.ViewModels"
             xmlns:v="clr-namespace:Folga.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:AgoraViewModel}">
    <UserControl.Resources>
        <Style x:Key="MetricCell" TargetType="StackPanel">
            <Setter Property="Margin" Value="20,14,20,14" />
        </Style>
        <Style x:Key="MetricDivider" TargetType="Rectangle">
            <Setter Property="Width" Value="1" />
            <Setter Property="Fill" Value="{StaticResource LineBrush}" />
            <Setter Property="Margin" Value="0,12" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <!-- Margem à direita: espaço para a barra de rolagem não encostar no conteúdo. -->
        <StackPanel Margin="0,0,16,0">
            <!-- Jogo + botão principal -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding GameTitle}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Headline}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSessionActive}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding GameNote}" Style="{StaticResource Text.Body}" Margin="0,6,24,0" />
                </StackPanel>
                <ToggleButton Grid.Column="1" Style="{StaticResource BoostToggle}" VerticalAlignment="Top"
                              IsChecked="{Binding BoostEnabled}"
                              ToolTip="Liga ou desliga o Folga. Ligado: quando um jogo da lista abre, ele ganha prioridade e os apps de fundo são segurados; ao fechar, tudo volta. Desligar no meio do jogo desfaz na hora.">
                    <ToggleButton.Content>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Boost desligado" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BoostEnabled}" Value="True">
                                            <Setter Property="Text" Value="Boost ligado" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </ToggleButton.Content>
                </ToggleButton>
            </Grid>

            <!-- Jogo: FPS, GPU e ping -->
            <Border Style="{StaticResource Panel}" Margin="0,24,0,0">
                <StackPanel>
                    <WrapPanel>
                        <StackPanel Style="{StaticResource MetricCell}"
                                    ToolTip="Quadros por segundo no último segundo, medidos pelos eventos de apresentação do DirectX (DX10, 11 e 12), por fora do jogo. Nada é injetado.">
                            <TextBlock Text="FPS" Style="{StaticResource Text.Label}" />
                            <TextBlock Text="{Binding FpsText}" Style="{StaticResource Text.Number}" Foreground="{StaticResource AccentBrush}" />
                        </StackPanel>
                        <Rectangle Style="{StaticResource MetricDivider}" />
                        <StackPanel Style="{StaticResource MetricCell}"
                                    ToolTip="1% low dos últimos 30 s: o FPS dos 1% piores quadros (percentil 99 do frametime). Mostra as travadinhas que o FPS médio esconde; é aqui que o Folga deve fazer diferença.">
                            <TextBlock Text="1% low" Style="{StaticResource Text.Label}" />
                            <TextBlock Text="{Binding LowText}" Style="{StaticResource Text.Number}" />
                        </StackPanel>
                        <Rectangle Style="{StaticResource MetricDivider}" />
                        <StackPanel Style="{StaticResource MetricCell}"
                                    ToolTip="Tempo médio de cada quadro no último segundo, em milissegundos. 16,7 ms = 60 FPS; quanto mais estável, mais suave.">
                            <TextBlock Text="Frametime (ms)" Style="{StaticResource Text.Label}" />
                            <TextBlock Text="{Binding FrameTimeText}" Style="{StaticResource Text.Number}" />
                        </StackPanel>
                        <Rectangle Style="{StaticResource MetricDivider}" />
                        <StackPanel Style="{StaticResource MetricCell}" ToolTip="{Binding GpuName, StringFormat='Uso da placa de vídeo ({0}). Perto de 99% durante o jogo é normal: a placa é o limite, não a CPU.'}">
                            <TextBlock Text="GPU" Style="{StaticResource Text.Label}" />
                            <TextBlock Text="{Binding GpuText}" Style="{StaticResource Text.Number}" />
                        </StackPanel>
                        <Rectangle Style="{StaticResource MetricDivider}" />
                        <StackPanel Style="{StaticResource MetricCell}"
                                    ToolTip="Memória de vídeo em uso. Se encostar no total, o jogo começa a usar a RAM do PC e trava; baixe a qualidade das texturas.">
                            <TextBlock Text="VRAM (GB)" Style="{StaticResource Text.Label}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding VramText}" Style="{StaticResource Text.Number}" />
                                <TextBlock Text="{Binding VramTotalText}" Style="{StaticResource Text.Label}" VerticalAlignment="Bottom" Margin="6,0,0,6" />
                            </StackPanel>
                        </StackPanel>
                        <Rectangle Style="{StaticResource MetricDivider}" />
                        <StackPanel Style="{StaticResource MetricCell}"
                                    ToolTip="Temperatura da GPU (só NVIDIA, pela NVML do driver). Até uns 80° é normal em jogo.">
                            <TextBlock Text="GPU °C" Style="{StaticResource Text.Label}" />
                            <TextBlock Text="{Binding GpuTempText}" Style="{StaticResource Text.Number}" />
                        </StackPanel>
                        <Rectangle Style="{StaticResource MetricDivider}" />
                        <StackPanel Style="{StaticResource MetricCell}"
                                    ToolTip="Ping até o servidor da partida, em ms. O Folga descobre o servidor pelo tráfego do jogo e mede por ICMP a cada 2 s; alguns servidores não respondem a ping, e aí aparece —.">
                            <TextBlock Text="Ping (ms)" Style="{StaticResource Text.Label}" />
                            <TextBlock Text="{Binding PingText}" Style="{StaticResource Text.Number}" />
                        </StackPanel>
                    </WrapPanel>

                    <Rectangle Height="1" Fill="{StaticResource LineBrush}" />
                    <Grid Margin="16,12,16,12"
                          ToolTip="Frametime de cada quadro nos últimos 60 s (cada ponto é o pior quadro daquele trecho). Linha reta e baixa = jogo suave; picos = travadas.">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="110" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding TelemetryNote}" Style="{StaticResource Text.Label}" TextTrimming="CharacterEllipsis" Margin="16,0,0,0" />
                            <TextBlock Text="Frametime, últimos 60 s" Style="{StaticResource Text.Label}" />
                        </DockPanel>
                        <v:FrameTimeChart Grid.Row="1" Samples="{Binding FrameTimes}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Sistema -->
            <Border Style="{StaticResource Panel}" Margin="0,12,0,0">
                <WrapPanel>
                    <StackPanel Style="{StaticResource MetricCell}" ToolTip="Uso total do processador agora, igual ao Gerenciador de Tarefas.">
                        <TextBlock Text="CPU" Style="{StaticResource Text.Label}" />
                        <TextBlock Text="{Binding CpuText}" Style="{StaticResource Text.Number}" />
                    </StackPanel>
                    <Rectangle Style="{StaticResource MetricDivider}" />
                    <StackPanel Style="{StaticResource MetricCell}" ToolTip="Memória ocupada por programas agora. O cache (standby) não entra na conta.">
                        <TextBlock Text="RAM em uso (GB)" Style="{StaticResource Text.Label}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding RamUsedText}" Style="{StaticResource Text.Number}" />
                            <TextBlock Text="{Binding RamTotalText}" Style="{StaticResource Text.Label}" VerticalAlignment="Bottom" Margin="6,0,0,6" />
                        </StackPanel>
                    </StackPanel>
                    <Rectangle Style="{StaticResource MetricDivider}" />
                    <StackPanel Style="{StaticResource MetricCell}" ToolTip="RAM realmente vaga, pronta para o jogo usar sem esperar. Se cair abaixo do limite da tela Segundo plano durante o jogo, o Folga limpa a standby list.">
                        <TextBlock Text="RAM livre (GB)" Style="{StaticResource Text.Label}" />
                        <TextBlock Text="{Binding FreeText}" Style="{StaticResource Text.Number}" />
                    </StackPanel>
                    <Rectangle Style="{StaticResource MetricDivider}" />
                    <StackPanel Style="{StaticResource MetricCell}" ToolTip="Arquivos que o Windows guarda na RAM para abrir mais rápido. É liberado sob demanda, mas a liberação pode causar engasgos; por isso o Folga limpa antes quando a RAM livre fica baixa.">
                        <TextBlock Text="Standby (GB)" Style="{StaticResource Text.Label}" />
                        <TextBlock Text="{Binding StandbyText}" Style="{StaticResource Text.Number}" />
                    </StackPanel>
                    <Rectangle Style="{StaticResource MetricDivider}" />
                    <StackPanel Style="{StaticResource MetricCell}" ToolTip="Quantos processos de fundo (abas do navegador, Discord, launchers) estão com prioridade, núcleos e memória reduzidos agora. Só conta com um jogo aberto.">
                        <TextBlock Text="Apps segurados" Style="{StaticResource Text.Label}" />
                        <TextBlock Text="{Binding HeldText}" Style="{StaticResource Text.Number}" />
                    </StackPanel>
                    <Rectangle Style="{StaticResource MetricDivider}" />
                    <StackPanel Style="{StaticResource MetricCell}" ToolTip="Primeiro número: processos esvaziados por passarem do orçamento de RAM (a memória vai para o disco, o app não fecha). Segundo: limpezas da standby list nesta sessão.">
                        <TextBlock Text="Esvaziados · limpezas" Style="{StaticResource Text.Label}" />
                        <TextBlock Text="{Binding CleanupText}" Style="{StaticResource Text.Number}" />
                    </StackPanel>
                </WrapPanel>
            </Border>

            <!-- Mapa de núcleos -->
            <DockPanel Margin="0,28,0,10">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="10" Height="10" CornerRadius="2" Background="{StaticResource AccentBrush}" />
                    <TextBlock Text="jogo" Style="{StaticResource Text.Label}" Margin="6,0,16,0"
                               ToolTip="Parte da barra que é do jogo, medida agora pela amostragem de CPU do Windows (precisa do Folga como administrador e de um jogo aberto)." />
                    <Border Width="10" Height="10" CornerRadius="2" Background="{StaticResource TextTertiaryBrush}" />
                    <TextBlock Text="outros programas" Style="{StaticResource Text.Label}" Margin="6,0,0,0"
                               ToolTip="Parte da barra usada por qualquer outro programa (navegador, Discord, o próprio Windows)." />
                </StackPanel>
                <TextBlock Text="Núcleos" Style="{StaticResource Text.Section}"
                           ToolTip="Mapa da sua CPU: cada quadro é um núcleo físico e cada barra é uma thread, com o uso em % medido agora. Com um jogo aberto, a parte âmbar da barra é o jogo e a cinza são os outros programas. O rótulo do quadro diz o que pode rodar ali: jogo (escolhido na tela Jogos) e fundo (regras de Segundo plano)." />
            </DockPanel>
            <TextBlock Text="{Binding CoreLegend}" Style="{StaticResource Text.Body}" Margin="0,0,0,4" />
            <TextBlock Text="{Binding CoreSplitNote}" Style="{StaticResource Text.Label}" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,4" TextWrapping="Wrap"
                       Visibility="{Binding CoreSplitNote, Converter={x:Static vm:NotNullToVisibilityConverter.Instance}}" />
            <Rectangle Height="8" />

            <ItemsControl ItemsSource="{Binding Cores}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding DataContext.CoreColumns, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:CoreTileViewModel}">
                        <Border x:Name="Tile" Style="{StaticResource Panel}" Margin="0,0,8,8" Padding="12,10"
                                ToolTip="Cada barra é uma thread deste núcleo, com o uso em % (passe o mouse na barra para ver quanto é do jogo). Borda âmbar: o jogo pode rodar neste núcleo agora, lido do Windows. Fundo: as regras de Segundo plano põem os apps de fundo aqui durante o jogo.">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock x:Name="RoleText" DockPanel.Dock="Right" Text="{Binding Role}" Style="{StaticResource Text.Label}" />
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Label}" Foreground="{StaticResource TextSecondaryBrush}" />
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding Threads}" Margin="0,10,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ThreadBarViewModel}">
                                            <StackPanel Margin="0,0,6,0" ToolTip="{Binding Hint}" Background="Transparent">
                                                <!-- Barra vertical: altura total = uso da thread; parte âmbar embaixo = o jogo. -->
                                                <Grid Height="56">
                                                    <Border Background="{StaticResource BackgroundBrush}" CornerRadius="3" />
                                                    <Border VerticalAlignment="Bottom" CornerRadius="3" Background="{StaticResource TextTertiaryBrush}">
                                                        <Border.Height>
                                                            <MultiBinding Converter="{x:Static vm:PercentToHeightConverter.Instance}">
                                                                <Binding Path="Usage" />
                                                                <Binding Source="56" />
                                                            </MultiBinding>
                                                        </Border.Height>
                                                    </Border>
                                                    <Border VerticalAlignment="Bottom" CornerRadius="3" Background="{StaticResource AccentBrush}">
                                                        <Border.Height>
                                                            <MultiBinding Converter="{x:Static vm:PercentToHeightConverter.Instance}" ConverterParameter="0">
                                                                <Binding Path="GameUsage" />
                                                                <Binding Source="56" />
                                                            </MultiBinding>
                                                        </Border.Height>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="{Binding Text}" Style="{StaticResource Text.Label}" HorizontalAlignment="Center" Margin="0,4,0,0"
                                                           Typography.NumeralAlignment="Tabular" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsGameActive}" Value="True">
                                <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="RoleText" Property="Foreground" Value="{StaticResource AccentBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Avisos -->
            <Border Style="{StaticResource Panel}" Margin="0,16,0,0" Padding="14,10"
                    Visibility="{Binding RamWarning, Converter={x:Static vm:NotNullToVisibilityConverter.Instance}}">
                <TextBlock Text="{Binding RamWarning}" Style="{StaticResource Text.Body}" Foreground="{StaticResource AccentBrush}" />
            </Border>

            <!-- Atividade -->
            <DockPanel Margin="0,28,0,10">
                <TextBlock DockPanel.Dock="Right" Text="{Binding RamSpeed}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                <TextBlock Text="Atividade" Style="{StaticResource Text.Section}"
                           ToolTip="Últimas ações do Folga: jogo detectado, apps segurados, o que foi desfeito e avisos. O histórico completo fica na pasta de logs do Folga (%LocalAppData%\Folga\logs)." />
            </DockPanel>
            <Border Style="{StaticResource Panel}" Padding="14,10">
                <ItemsControl ItemsSource="{Binding Activity}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Style="{StaticResource Text.Mono}" Margin="0,2" ToolTip="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
